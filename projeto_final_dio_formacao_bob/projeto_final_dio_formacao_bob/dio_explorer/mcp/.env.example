# ──────────────────────────────────────────────────────────────────────────────
# DIO Explorer — MCP Server  |  Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de iniciar o servidor.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Servidor HTTP ─────────────────────────────────────────────────────────────

# Porta em que o servidor irá escutar (padrão: 3000)
PORT=3000

# Interface de rede a ser usada (0.0.0.0 = todas as interfaces)
HOST=0.0.0.0

# URL pública do servidor (usada nos redirects OAuth/SSO)
PUBLIC_BASE_URL=http://localhost:3000

# Origens permitidas no CORS (separadas por vírgula; use * para todas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Autenticação JWT ──────────────────────────────────────────────────────────

# Habilita autenticação JWT em /api e /mcp (true por padrão; false = sem auth)
ENABLE_AUTH=true

# Segredo para assinar tokens JWT — TROQUE em produção!
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE-ESTE-VALOR-EM-PRODUCAO

# Validade do token JWT (ex: 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# ── TLS / HTTPS ───────────────────────────────────────────────────────────────
# Deixe em branco para rodar em HTTP (adequado atrás de proxy reverso como Nginx/Caddy).
# Para HTTPS direto, aponte para os arquivos PEM gerados.
# Consulte mcp/certs/README.md para instruções de geração.

# Caminho para o certificado TLS (PEM)
# NODE_TLS_CERT=./certs/server.crt

# Caminho para a chave privada TLS (PEM)
# NODE_TLS_KEY=./certs/server.key

# ── SSO — Google OAuth2 ───────────────────────────────────────────────────────
# Crie um projeto no Google Cloud Console → APIs & Services → Credentials
# Adicione http://localhost:3000/auth/sso/google/callback como Redirect URI autorizado.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SSO — GitHub OAuth2 ───────────────────────────────────────────────────────
# Crie um OAuth App em: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/auth/sso/github/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
